<section class="main clearfix">

    <%
        // cover: explicit cover_detail, otherwise the first photo in the content, otherwise the theme default
        var cover = item.cover_detail;
        if (!cover) {
            var firstImg = (item.content || '').match(/<img[^>]*\ssrc="([^"#]+)/);
            if (firstImg) cover = firstImg[1];
        }
        var coverPosition = item.cover_position;
        if (!cover) {
            cover = theme.default_cover_detail;
            coverPosition = coverPosition || theme.default_cover_position;
        }
    %>
    <section class="top" style="background: url('<%- cover %>');<% if (coverPosition) { %> background-position: <%- coverPosition %> !important;<% } %>">
        <div class="wrapper content_header clearfix">
            <h1 class="title"><%- item.title || theme.default_post_title || "Untitled" %></h1>
        </div>
    </section><!-- end top -->

    <section class="wrapper">
        <div class="content">

            <!-- Gallery -->
            <% if (item.photos && item.photos.length){ %>
                <%- partial('gallery') %>
            <% } %>

            <!-- Content -->
            <%- item.content %>

            <!-- Comments -->
            <div>
                <%- partial("_partial/comments.ejs") %>
            </div>
        </div><!-- end content -->
    </section>
</section><!-- end main -->